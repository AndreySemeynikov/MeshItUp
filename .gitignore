# Logs & Temp
# ===========================
logs/
*.log
tmp/
temp/
.cache/

# ===========================
# Keep these (exceptions)
# ===========================
# Keep go.mod and go.sum (dependency tracking)
!go-services/**/go.mod
!go-services/**/go.sum

# Keep k8s manifests
!*.yaml
!*.yml
!k8s/**/*.yaml
!k8s/**/*.yml

# Keep Dockerfiles
!Dockerfile
!**/Dockerfile

# Keep documentation
!*.md
