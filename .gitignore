# Project-Specific Excludes
# ===========================
# Archive files (not part of source)
*.zip
*.tar
*.gz
*.rar
*.7z

# Documentation exports
*.pdf
*.docx

# Local configuration overrides
*.local.yaml
*.local.yml
.local.env
.env.local

